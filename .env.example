# =============================================================================
#  career-ai-agent — environment variable template
#
#  ✅  This file IS committed to Git — it contains NO real secrets.
#  🚀  First-time setup: copy this file to .env and fill in your values.
#
#      cp .env.example .env
#
# =============================================================================

# ─── LLM Provider (OpenRouter) ───────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── LangSmith Observability ─────────────────────────────────────────────────
# Get your key at https://smith.langchain.com
# Set LANGSMITH_TRACING=false to disable tracing entirely (no key needed).
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=career-ai-agent

# ─── Application ─────────────────────────────────────────────────────────────
# Runtime environment (development | staging | production)
APP_ENV=development

# Logging verbosity (DEBUG | INFO | WARNING | ERROR | CRITICAL)
APP_LOG_LEVEL=INFO

# ─── LLM Settings ────────────────────────────────────────────────────────────
# The model identifier passed to OpenRouter.
# See full list at https://openrouter.ai/models
MODEL_NAME=openai/gpt-4o-mini

# Sampling temperature — 0.0 = deterministic, 1.0 = creative
TEMPERATURE=0.0

# ─── Embedding Model ─────────────────────────────────────────────────────────
# HuggingFace sentence-transformers model — runs locally, no extra key needed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── RAG Pipeline ────────────────────────────────────────────────────────────
# Number of retrieved chunks passed to the LLM as context
TOP_K=5

# Characters per document chunk
CHUNK_SIZE=1000

# Overlap between consecutive chunks (prevents context loss at boundaries)
CHUNK_OVERLAP=200

# ─── Vector Store (ChromaDB) ─────────────────────────────────────────────────
# Local path where ChromaDB will persist its index files
VECTOR_DB_PATH=storage/vector_db

# ChromaDB collection name
CHROMA_COLLECTION_NAME=career_documents

# ─── Relational Database ─────────────────────────────────────────────────────
# SQLAlchemy connection string.
# Default uses SQLite for zero-setup local development.
DATABASE_URL=sqlite:///storage/career_ai_agent.db

# ─── MCP Server ──────────────────────────────────────────────────────────────
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8080
