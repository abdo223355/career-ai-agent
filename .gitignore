# =============================================================================
#  career-ai-agent — .gitignore
#  Safe to publish on GitHub — no secrets, no generated artefacts.
# =============================================================================

# ─── Secrets — NEVER commit ──────────────────────────────────────────────────
.env
.env.local
.env.*.local
# Allow the template file
!.env.example

# ─── Python bytecode ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ─── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ─── Distribution / packaging ────────────────────────────────────────────────
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── PyInstaller ─────────────────────────────────────────────────────────────
*.manifest
*.spec

# ─── Installer logs ──────────────────────────────────────────────────────────
pip-log.txt
pip-delete-this-directory.txt

# ─── Testing & coverage ──────────────────────────────────────────────────────
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# ─── Type checkers ───────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ─── IDEs ────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── OS artefacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
# Notebooks themselves are committed — only checkpoints are ignored

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Runtime storage (generated at runtime — never commit) ───────────────────
storage/vector_db/
storage/cache/

# ─── Vector store / database files ───────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
chroma/
faiss_index/

# ─── Large data files ────────────────────────────────────────────────────────
# PDFs are checked-in intentionally for this project.
# Add the lines below if you want to exclude them in a fork without large files:
# data/*.pdf
# data/*.csv
# data/*.json
# data/*.txt

# Notebook artifacts
storage/
append_*.py
*_nb*.py
*_export.txt
fix_*.py
build_*.py
patch_*.py
measure_*.py
tighten_*.py
update_*.py
verify_*.py
remove_*.py
apply_*.py
probe_*.py
inspect_*.py
test_*.py
convert_*.py
final_*.py
